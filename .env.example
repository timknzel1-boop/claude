# --- Telegram (https://my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Wird von `python -m community_brain login` erzeugt
TELEGRAM_SESSION=
# ID oder @username der Community-Gruppe (von `login` angezeigt), z.B. -1001234567890
TELEGRAM_GROUP=
# Beim allerersten Lauf so viele Tage Verlauf nachholen
BACKFILL_DAYS=30

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Notion (optional, sonst nur Markdown in ./output) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Sprachnachrichten transkribieren (braucht faster-whisper) ---
TRANSCRIBE_VOICE=0
