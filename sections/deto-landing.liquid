<script>
(function() {
  var opts = document.querySelectorAll('.deto-variant-option');
  var priceEl = document.getElementById('deto-price');
  var variantInput = document.getElementById('deto-variant-id');

  opts.forEach(function(btn) {
    btn.addEventListener('click', function() {
      opts.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      priceEl.textContent = btn.dataset.price;
      variantInput.value = btn.dataset.variant;
