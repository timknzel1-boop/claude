.rv-hd{text-align:center;margin-bottom:16px}
.rv-ti{font-size:26px;font-weight:700;color:#191919;margin:0 0 8px}
.rv-su{display:flex;align-items:center;justify-content:center;gap:8px}
.rv-as{color:#00b67a;font-size:20px;letter-spacing:2px}
.rv-at{font-size:15px;color:#555}
.rv-bd{max-width:400px;margin:0 auto 20px;display:flex;flex-direction:column;gap:5px}
.rv-br{display:flex;align-items:center;gap:8px;width:100%;background:none;border:none;padding:3px 4px;border-radius:5px;cursor:pointer;font-family:inherit;transition:background .15s}
.rv-br:hover,.rv-br.rv-on{background:#eafaf3}
.rv-bl{font-size:13px;color:#555;min-width:28px;text-align:left}
.rv-bb{flex:1;height:9px;background:#ececec;border-radius:5px;overflow:hidden}
.rv-bf{display:block;height:100%;background:#00b67a;border-radius:5px}
.rv-bp{font-size:12px;color:#888;min-width:32px;text-align:right}
.rv-ct{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.rv-fi,.rv-so{display:flex;gap:5px;flex-wrap:wrap}
.rv-f,.rv-sb{padding:5px 12px;border:1px solid #ddd;border-radius:20px;background:#fff;font-size:13px;cursor:pointer;font-family:inherit;color:#555;transition:all .15s}
.rv-f:hover,.rv-sb:hover{border-color:#00b67a;color:#00b67a}
.rv-f.rv-on,.rv-sb.rv-on{background:#00b67a;color:#fff;border-color:#00b67a}
.rv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.rv-card{background:#fff;border:1px solid #e8e8e8;border-radius:10px;padding:16px 14px;display:flex;flex-direction:column;gap:7px}
.rv-hidden{display:none!important}
.s5{color:#00b67a;font-size:14px;letter-spacing:1px}
.s4{color:#00b67a;font-size:14px;letter-spacing:1px}
.s3{color:#ff8622;font-size:14px;letter-spacing:1px}
.s2{color:#ff4c4c;font-size:14px;letter-spacing:1px}
.s1{color:#cc0000;font-size:14px;letter-spacing:1px}
.s4 .e,.s3 .e,.s2 .e,.s1 .e{color:#dcdce6}
.rt{margin:0;font-size:14px;color:#333;line-height:1.5;flex:1}
.rm{font-size:12px;color:#888}
.rv-mw{text-align:center;margin-top:24px}
.rv-mb{display:inline-block;padding:11px 26px;background:#00b67a;color:#fff;border:none;border-radius:6px;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s}
.rv-mb:hover{background:#009e6a}
.rv-ww{text-align:center;margin-top:16px}
.rv-wb{background:none;border:none;font-size:14px;color:#555;cursor:pointer;text-decoration:underline;text-underline-offset:2px;font-family:inherit}
.rv-wb:hover{color:#00b67a}
.rv-fb{display:none;max-width:460px;margin:16px auto 0;background:#fff;border:1px solid #e8e8e8;border-radius:10px;padding:22px 20px;text-align:left}
.rv-fb.rv-open{display:block}
.rv-ft{font-size:16px;font-weight:700;color:#191919;margin:0 0 12px}
.rv-sr{display:flex;gap:4px;margin-bottom:14px;font-size:28px;color:#dcdce6;cursor:pointer}
.rv-sp.on,.rv-sp.hv{color:#00b67a}
.rv-in,.rv-ta{display:block;width:100%;box-sizing:border-box;border:1px solid #ddd;border-radius:5px;padding:9px 11px;font-size:14px;font-family:inherit;color:#191919;margin-bottom:9px;outline:none}
.rv-in:focus,.rv-ta:focus{border-color:#00b67a}
.rv-ta{resize:vertical;min-height:80px}
.rv-fn{font-size:12px;color:#aaa;margin:0 0 12px}
.rv-fs{background:#00b67a;color:#fff;border:none;border-radius:5px;padding:10px 24px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
.rv-fs:hover{background:#009e6a}
.rv-ok{display:none;color:#00b67a;font-weight:600;text-align:center;padding:8px 0}
.rv-fl{position:fixed;right:18px;bottom:22px;z-index:9999;display:none;align-items:center;gap:6px;padding:10px 16px;background:#00b67a;color:#fff;border:none;border-radius:28px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.18);transition:background .2s}
.rv-fl.rv-show{display:inline-flex}
.rv-fl:hover{background:#009e6a}
@media(max-width:768px){.rv-grid{grid-template-columns:repeat(2,1fr)}.rv-ti{font-size:22px}.rv-ct{flex-direction:column;align-items:flex-start}}
@media(max-width:480px){.rv-grid{grid-template-columns:1fr}}
</style>
<script>
(function(){
var sec=document.getElementById('msv-reviews');
var grid=document.getElementById('rv-grid-{{section.id}}');
var mw=document.getElementById('rv-mw-{{section.id}}');
var mb=document.getElementById('rv-mb-{{section.id}}');
var fl=document.getElementById('rv-fl-{{section.id}}');
var fbtns=document.querySelectorAll('#rv-ct-{{section.id}} .rv-f');
var sbtns=document.querySelectorAll('#rv-ct-{{section.id}} .rv-sb');
var brows=document.querySelectorAll('#rv-bd-{{section.id}} .rv-br');
var exp=false,af='all',as2='desc';
function cards(){return Array.from(grid.querySelectorAll('.rv-card'));}
function sort(dir){cards().sort(function(a,b){var da=a.dataset.date,db=b.dataset.date;return dir==='desc'?db.localeCompare(da):da.localeCompare(db);}).forEach(function(c){grid.appendChild(c);});}
function apply(){
var n=0;
cards().forEach(function(c){
var m=af==='all'||c.dataset.stars===af;
if(!m){c.style.display='none';return;}
if(af!=='all'||exp){c.style.display='';return;}
n++;c.style.display=n<=9?'':'none';
});
if(mw)mw.style.display=(af==='all'&&!exp)?'':'none';
}
function setf(v){
af=v;
fbtns.forEach(function(b){b.classList.toggle('rv-on',b.dataset.filter===v);});
brows.forEach(function(r){r.classList.toggle('rv-on',r.dataset.filter===v);});
apply();
}
sort('desc');apply();
if(mb)mb.addEventListener('click',function(){exp=true;apply();});
fbtns.forEach(function(b){b.addEventListener('click',function(){setf(this.dataset.filter);});});
brows.forEach(function(r){r.addEventListener('click',function(){setf(af===this.dataset.filter?'all':this.dataset.filter);});});
sbtns.forEach(function(b){b.addEventListener('click',function(){as2=this.dataset.sort;sbtns.forEach(function(x){x.classList.remove('rv-on')});this.classList.add('rv-on');sort(as2);apply();});});
if(fl&&sec){
var uf=function(){var r=sec.getBoundingClientRect();fl.classList.toggle('rv-show',r.top<-200&&r.bottom>window.innerHeight);};
window.addEventListener('scroll',uf,{passive:true});
window.addEventListener('resize',uf,{passive:true});
uf();
fl.addEventListener('click',function(){exp=false;setf('all');sec.scrollIntoView({behavior:'smooth',block:'start'});});
}
var wb=document.getElementById('rv-wb-{{section.id}}');
var fb=document.getElementById('rv-fb-{{section.id}}');
if(wb&&fb)wb.addEventListener('click',function(){var o=!fb.classList.contains('rv-open');fb.classList.toggle('rv-open');if(o)fb.scrollIntoView({behavior:'smooth',block:'nearest'});});
var sps=document.querySelectorAll('#rv-sr-{{section.id}} .rv-sp'),ch=5;
sps.forEach(function(s){s.classList.add('on');});
sps.forEach(function(s,i){
s.addEventListener('mouseenter',function(){sps.forEach(function(x,j){x.classList.remove('on');x.classList.toggle('hv',j<=i);});});
s.addEventListener('mouseleave',function(){sps.forEach(function(x,j){x.classList.remove('hv');x.classList.toggle('on',j<ch);});});
s.addEventListener('click',function(){ch=i+1;sps.forEach(function(x,j){x.classList.toggle('on',j<ch);});});
});
var frm=document.getElementById('rv-form-{{section.id}}');
var ok=document.getElementById('rv-ok-{{section.id}}');
if(frm)frm.addEventListener('submit',function(e){
e.preventDefault();
var n2=frm.querySelector('[name="name"]').value.trim();
var em=frm.querySelector('[name="email"]').value.trim();
var bo=frm.querySelector('[name="body"]').value.trim();
if(!n2||!em||!bo)return;
var fd=new FormData();
fd.append('form_type','contact');fd.append('utf8','✓');
fd.append('contact[name]',n2);fd.append('contact[email]',em);
fd.append('contact[body]','★'.repeat(ch)+' ('+ch+'/5)

'+bo);
var btn=frm.querySelector('.rv-fs');btn.disabled=true;btn.textContent='...';
fetch('/contact',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}})
.then(function(){frm.style.display='none';if(ok)ok.style.display='block';})
.catch(function(){btn.disabled=false;btn.textContent='Absenden';});
});
})();
</script>
