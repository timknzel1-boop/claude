<script>
  (function(){
    var section  = document.getElementById('msv-reviews');
    var grid     = document.getElementById('msv-rv-grid-{{ section.id }}');
    var moreBtn  = document.getElementById('msv-rv-btn-{{ section.id }}');
    var moreWrap = document.getElementById('msv-rv-more-wrap-{{ section.id }}');
    var filterBtns = document.querySelectorAll('#msv-rv-ctrl-{{ section.id }} .msv-rv-f');
    var sortBtns   = document.querySelectorAll('#msv-rv-ctrl-{{ section.id }} .msv-rv-sb');
    var bdRows     = document.querySelectorAll('#msv-rv-bd-{{ section.id }} .msv-rv-bd-row');
    var floatBtn   = document.getElementById('msv-rv-float-{{ section.id }}');
    var expanded = false, activeFilter = 'all', activeSort = 'desc';

    function allCards(){ return Array.from(grid.querySelectorAll('.msv-rv-card')); }

    function sortCards(dir){
      allCards().sort(function(a,b){
        var da=a.dataset.date, db=b.dataset.date;
        return dir==='desc' ? db.localeCompare(da) : da.localeCompare(db);
      }).forEach(function(c){ grid.appendChild(c); });
    }

    function applyState(){
      var cnt=0;
      allCards().forEach(function(c){
        var match = activeFilter==='all' || c.dataset.stars===activeFilter;
        if(!match){ c.style.display='none'; return; }
        if(activeFilter!=='all'){ c.style.display=''; return; }
        if(expanded){ c.style.display=''; return; }
        cnt++; c.style.display = cnt<=9 ? '' : 'none';
      });
      if(moreWrap) moreWrap.style.display = (activeFilter==='all'&&!expanded) ? '' : 'none';
    }

    sortCards('desc'); applyState();

    if(moreBtn) moreBtn.addEventListener('click', function(){
      expanded=true; applyState();
    });

    function setFilter(val){
      activeFilter = val;
      filterBtns.forEach(function(b){ b.classList.toggle('msv-rv-f-on', b.dataset.filter===val); });
      bdRows.forEach(function(r){ r.classList.toggle('msv-rv-bd-on', r.dataset.filter===val); });
      applyState();
    }

    filterBtns.forEach(function(btn){
      btn.addEventListener('click', function(){ setFilter(this.dataset.filter); });
    });

    bdRows.forEach(function(row){
      row.addEventListener('click', function(){
        var val = this.dataset.filter;
        // Klick auf bereits aktive Verteilung = zurück zu "Alle"
        setFilter(activeFilter===val ? 'all' : val);
      });
    });

    sortBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        activeSort=this.dataset.sort;
        sortBtns.forEach(function(b){b.classList.remove('msv-rv-sb-on');});
        this.classList.add('msv-rv-sb-on');
        sortCards(activeSort); applyState();
      });
    });

    // Schwimmender Schließen-/Hoch-Button
    if(floatBtn && section){
      function updateFloat(){
        var r = section.getBoundingClientRect();
        // Sichtbar wenn Sektion den Viewport überspannt (man tief drin scrollt)
        var deep = r.top < -200 && r.bottom > window.innerHeight;
        floatBtn.classList.toggle('msv-rv-float-show', deep);
      }
      window.addEventListener('scroll', updateFloat, { passive: true });
      window.addEventListener('resize', updateFloat, { passive: true });
      updateFloat();
      floatBtn.addEventListener('click', function(){
        // Alle wieder einklappen und nach oben zur Sektion
        expanded = false;
        setFilter('all');
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    var writeBtn = document.getElementById('msv-rv-write-btn-{{ section.id }}');
    var formBox  = document.getElementById('msv-rv-form-box-{{ section.id }}');
    if(writeBtn&&formBox) writeBtn.addEventListener('click', function(){
      var opening=!formBox.classList.contains('msv-open');
      formBox.classList.toggle('msv-open');
      if(opening) formBox.scrollIntoView({behavior:'smooth',block:'nearest'});
    });

    var picks=document.querySelectorAll('#msv-rv-stars-{{ section.id }} .msv-rv-sp'), chosen=5;
    picks.forEach(function(s){s.classList.add('on');});
    picks.forEach(function(star,idx){
      star.addEventListener('mouseenter',function(){
        picks.forEach(function(s,i){s.classList.remove('on');s.classList.toggle('hov',i<=idx);});
      });
      star.addEventListener('mouseleave',function(){
        picks.forEach(function(s,i){s.classList.remove('hov');s.classList.toggle('on',i<chosen);});
      });
      star.addEventListener('click',function(){
        chosen=idx+1;
        picks.forEach(function(s,i){s.classList.toggle('on',i<chosen);});
      });
    });

    var form=document.getElementById('msv-rv-contactform-{{ section.id }}');
    var succ=document.getElementById('msv-rv-success-{{ section.id }}');
    if(form) form.addEventListener('submit',function(e){
      e.preventDefault();
      var name=form.querySelector('[name="name"]').value.trim();
      var email=form.querySelector('[name="email"]').value.trim();
      var body=form.querySelector('[name="body"]').value.trim();
      if(!name||!email||!body) return;
      var stars='★'.repeat(chosen)+'☆'.repeat(5-chosen);
      var msg='Neue Bewertung – mysolv\n\nName: '+name+'\nSterne: '+stars+' ('+chosen+'/5)\n\nBewertungstext:\n'+body;
      var fd=new FormData();
      fd.append('form_type','contact'); fd.append('utf8','✓');
      fd.append('contact[name]',name); fd.append('contact[email]',email); fd.append('contact[body]',msg);
      var btn=form.querySelector('.msv-rv-fsubmit');
      btn.disabled=true; btn.textContent='...';
      fetch('/contact',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(function(){form.style.display='none'; if(succ) succ.style.display='block';})
        .catch(function(){btn.disabled=false; btn.textContent='Absenden';});
    });
  })();
</script>
