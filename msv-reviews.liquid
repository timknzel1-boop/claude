.e{color:#ddd}
.rt{margin:0;font-size:14px;line-height:1.5;color:#222}.rt::first-letter{color:#00b67a;font-weight:700}
.rm{font-size:12px;color:#888;margin-top:auto}
.rv-more-wrap{text-align:center;margin:24px 0}
.rv-more{background:#00b67a;color:#fff;border:none;border-radius:8px;padding:12px 28px;font-size:15px;cursor:pointer;transition:background .15s}
.rv-more:hover{background:#009e6a}
.rv-wbwrap{text-align:center;margin-top:16px}
.rv-wbbtn{background:#fff;color:#00b67a;border:2px solid #00b67a;border-radius:8px;padding:11px 28px;font-size:15px;font-weight:600;cursor:pointer;transition:all .15s}
.rv-wbbtn:hover,.rv-wbbtn.rv-wbo{background:#00b67a;color:#fff}
.rv-wbpanel{max-height:0;overflow:hidden;transition:max-height .35s ease}
.rv-wbpanel.rv-wpo{max-height:500px}
.rv-wbinner{background:#f5fdf9;border:1.5px solid #c3ead9;border-radius:12px;padding:24px;margin-top:12px;text-align:left}
.rv-stars-pick{display:flex;gap:8px;margin-bottom:16px}
.rv-sp-s{font-size:28px;cursor:pointer;color:#ddd;transition:color .1s;user-select:none}
.rv-sp-s.rv-sp-on{color:#FF9900}
.rv-form{display:flex;flex-direction:column;gap:12px}
.rv-fi{border:1.5px solid #ddd;border-radius:8px;padding:10px 14px;font-size:14px;font-family:inherit;transition:border .15s}
.rv-fi:focus{border-color:#00b67a;outline:none}
.rv-fta{min-height:100px;resize:vertical}
.rv-fsub{background:#00b67a;color:#fff;border:none;border-radius:8px;padding:12px;font-size:15px;cursor:pointer;transition:background .15s}
.rv-fsub:hover{background:#009e6a}
.rv-float{position:fixed;bottom:24px;right:24px;background:#191919;color:#fff;border-radius:24px;padding:10px 18px;font-size:13px;cursor:pointer;display:none;z-index:999;box-shadow:0 4px 16px rgba(0,0,0,.2);transition:opacity .2s}
.rv-float.rv-fv{display:block}
@media(max-width:768px){.rv-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.rv-grid{grid-template-columns:1fr}.rv-ctrl{flex-direction:column;align-items:flex-start}.rv-float{bottom:16px;right:16px;font-size:12px;padding:8px 14px}}
</style>
<script>
(function(){
var SEC=document.getElementById('msv-reviews');
var GRID=document.getElementById('rv-grid-{{section.id}}');
var MWRAP=document.getElementById('rv-more-wrap-{{section.id}}');
var MBTN=document.getElementById('rv-more-{{section.id}}');
var FLOAT=document.getElementById('rv-float-{{section.id}}');
var cf=0,expanded=false;
function cards(){return Array.from(GRID.querySelectorAll('.rv-card'));}
function sort(dir){
  var cs=cards().sort(function(a,b){
    return dir==='asc'?a.dataset.date.localeCompare(b.dataset.date):b.dataset.date.localeCompare(a.dataset.date);
  });
  cs.forEach(function(c){GRID.appendChild(c);});
}
function apply(){
  var cs=cards(),shown=0;
  cs.forEach(function(c){
    var match=cf===0||parseInt(c.dataset.stars)===cf;
    if(cf!==0){c.classList.toggle('rv-hidden',!match);if(match)shown++;}
    else{if(!expanded&&shown<9){c.classList.remove('rv-hidden');shown++;}else if(!expanded){c.classList.add('rv-hidden');}else{c.classList.remove('rv-hidden');shown++;}}
  });
  if(MWRAP)MWRAP.style.display=(cf===0&&!expanded)?'block':'none';
}
function setf(v){
  cf=v;
  document.querySelectorAll('#rv-ctrl-{{section.id}} .rv-pill').forEach(function(p){
    p.classList.toggle('rv-pa',parseInt(p.dataset.f)===v);
  });
  document.querySelectorAll('#rv-bars-{{section.id}} .rv-br').forEach(function(b){
    b.classList.toggle('rv-ba',parseInt(b.dataset.f)===v);
  });
  apply();
}
document.querySelectorAll('#rv-ctrl-{{section.id}} .rv-pill').forEach(function(p){
  p.addEventListener('click',function(){setf(parseInt(p.dataset.f));});
});
document.querySelectorAll('#rv-ctrl-{{section.id}} .rv-sb').forEach(function(b){
  b.addEventListener('click',function(){
    document.querySelectorAll('#rv-ctrl-{{section.id}} .rv-sb').forEach(function(x){x.classList.remove('rv-sa');});
    b.classList.add('rv-sa');
    sort(b.dataset.d);
    apply();
  });
});
document.querySelectorAll('#rv-bars-{{section.id}} .rv-br').forEach(function(b){
  b.addEventListener('click',function(){setf(parseInt(b.dataset.f));});
});
if(MBTN)MBTN.addEventListener('click',function(){expanded=true;apply();});
// collapsible write-review panel
var wbBtn=document.getElementById('rv-wbbtn-{{section.id}}');
var wbPanel=document.getElementById('rv-wbpanel-{{section.id}}');
if(wbBtn&&wbPanel){
  wbBtn.addEventListener('click',function(){
    var open=wbPanel.classList.toggle('rv-wpo');
    wbBtn.classList.toggle('rv-wbo',open);
    wbBtn.textContent=open?'Schließen':'Bewertung absenden';
  });
}
var spEl=document.getElementById('rv-sp-{{section.id}}');
var svEl=document.getElementById('rv-stars-val-{{section.id}}');
if(spEl&&svEl){
  var stars=spEl.querySelectorAll('.rv-sp-s');
  function hl(v){stars.forEach(function(x){x.classList.toggle('rv-sp-on',parseInt(x.dataset.v)<=v);});}
  stars.forEach(function(s){
    s.addEventListener('mouseenter',function(){hl(parseInt(s.dataset.v));});
    s.addEventListener('click',function(){svEl.value=s.dataset.v;hl(parseInt(s.dataset.v));});
  });
  spEl.addEventListener('mouseleave',function(){
    var v=svEl.value?parseInt(svEl.value):0;hl(v);
  });
}
if(FLOAT){
  var uf=function(){
    if(!SEC)return;
    var r=SEC.getBoundingClientRect();
    if(r.top<-200){FLOAT.classList.add('rv-fv');}else{FLOAT.classList.remove('rv-fv');}
  };
  window.addEventListener('scroll',uf,{passive:true});
  FLOAT.addEventListener('click',function(){
    expanded=false;setf(0);
    if(SEC)SEC.scrollIntoView({behavior:'smooth',block:'start'});
  });
}
sort('desc');apply();
// Trustpilot-style boxes for review card stars
var sm={s5:5,s4:4,s3:3,s2:2,s1:1};
document.querySelectorAll('.rv-card [class^="s"]').forEach(function(el){
  var n=sm[el.className]||sm[el.className.split(' ')[0]];
  if(!n)return;
  var h='';
  for(var i=1;i<=5;i++){h+='<i style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;background:'+(i<=n?'#FF9900':'#e0e0e0')+';border-radius:3px;color:#fff;font-size:12px;font-style:normal;flex-shrink:0">★</i>';}
  el.innerHTML=h;el.style.display='inline-flex';el.style.gap='3px';
});
})();
</script>
