<script>
  (function(){
    var grid    = document.getElementById('msv-rv-grid-{{ section.id }}');
    var moreBtn = document.getElementById('msv-rv-btn-{{ section.id }}');
    var moreWrap= document.getElementById('msv-rv-more-wrap-{{ section.id }}');
    var filterBtns = document.querySelectorAll('#msv-rv-ctrl-{{ section.id }} .msv-rv-f');
    var sortBtns   = document.querySelectorAll('#msv-rv-ctrl-{{ section.id }} .msv-rv-sb');

    var expanded    = false;
    var activeFilter= 'all';
    var activeSort  = 'desc';

    function allCards() {
      return Array.from(grid.querySelectorAll('.msv-rv-card'));
    }

    // Sort DOM
    function sortCards(dir) {
      var cards = allCards();
      cards.sort(function(a, b) {
        var da = a.dataset.date, db = b.dataset.date;
        return dir === 'desc' ? db.localeCompare(da) : da.localeCompare(db);
      });
      cards.forEach(function(c) { grid.appendChild(c); });
    }

    // Apply filter + visibility
    function applyState() {
      var cards = allCards();
      var visCount = 0;
      cards.forEach(function(c) {
        var matchFilter = activeFilter === 'all' || c.dataset.stars === activeFilter;
        if (!matchFilter) {
          c.style.display = 'none';
          return;
        }
        // When filtering by specific star: show all matching
        if (activeFilter !== 'all') {
          c.style.display = '';
          return;
        }
        // "Alle" + expanded = show everything
        if (expanded) {
          c.style.display = '';
          return;
        }
        // "Alle" + not expanded = show first 9
        visCount++;
        c.style.display = visCount <= 9 ? '' : 'none';
      });
      // Show/hide mehr button
      if (moreWrap) {
        moreWrap.style.display = (activeFilter === 'all' && !expanded) ? '' : 'none';
      }
    }

    // Init: sort desc, apply state
    sortCards('desc');
    applyState();

    // Mehr laden
    if (moreBtn) {
      moreBtn.addEventListener('click', function() {
        expanded = true;
        applyState();
      });
    }

    // Filter buttons
    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        activeFilter = this.dataset.filter;
        filterBtns.forEach(function(b) { b.classList.remove('msv-rv-f-on'); });
        this.classList.add('msv-rv-f-on');
        applyState();
      });
    });

    // Sort buttons
    sortBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        activeSort = this.dataset.sort;
        sortBtns.forEach(function(b) { b.classList.remove('msv-rv-sb-on'); });
        this.classList.add('msv-rv-sb-on');
        sortCards(activeSort);
        applyState();
      });
    });

    // Toggle write form
    var writeBtn = document.getElementById('msv-rv-write-btn-{{ section.id }}');
    var formBox  = document.getElementById('msv-rv-form-box-{{ section.id }}');
    if (writeBtn && formBox) {
      writeBtn.addEventListener('click', function() {
        var opening = !formBox.classList.contains('msv-open');
        formBox.classList.toggle('msv-open');
        if (opening) formBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    // Star picker
    var picks  = document.querySelectorAll('#msv-rv-stars-{{ section.id }} .msv-rv-sp');
    var chosen = 5;
    picks.forEach(function(s) { s.classList.add('on'); });
    picks.forEach(function(star, idx) {
      star.addEventListener('mouseenter', function() {
        picks.forEach(function(s, i) { s.classList.remove('on'); s.classList.toggle('hov', i <= idx); });
      });
      star.addEventListener('mouseleave', function() {
        picks.forEach(function(s, i) { s.classList.remove('hov'); s.classList.toggle('on', i < chosen); });
      });
      star.addEventListener('click', function() {
        chosen = idx + 1;
        picks.forEach(function(s, i) { s.classList.toggle('on', i < chosen); });
      });
    });

    // Submit form
    var form    = document.getElementById('msv-rv-contactform-{{ section.id }}');
    var success = document.getElementById('msv-rv-success-{{ section.id }}');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var name  = form.querySelector('[name="name"]').value.trim();
        var email = form.querySelector('[name="email"]').value.trim();
        var body  = form.querySelector('[name="body"]').value.trim();
        if (!name || !email || !body) return;
        var stars = '&#9733;'.repeat(chosen) + '&#9734;'.repeat(5 - chosen);
        var msg   = 'Neue Bewertung – mysolv\n\nName: ' + name + '\nSterne: ' + stars + ' (' + chosen + '/5)\n\nBewertungstext:\n' + body;
        var fd = new FormData();
        fd.append('form_type', 'contact');
        fd.append('utf8', '✓');
        fd.append('contact[name]', name);
        fd.append('contact[email]', email);
        fd.append('contact[body]', msg);
        var btn = form.querySelector('.msv-rv-fsubmit');
        btn.disabled = true; btn.textContent = '...';
        fetch('/contact', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function() { form.style.display = 'none'; if (success) success.style.display = 'block'; })
          .catch(function() { btn.disabled = false; btn.textContent = 'Absenden'; });
      });
    }
  })();
</script>

